*.log

# Word's own lock file for an open .docx (~$<name>.docx) -- never a real file to track.
~$*.docx

# Demo/test account credential lists -- local convenience exports, not source. Real plaintext
# passwords live in these (the DB itself only ever stores a bcrypt hash) -- never meant to be
# committed, purely a local testing convenience regenerated on demand from the live DB.
test_accounts*.csv
JanSarthi_Test_Accounts.csv
JanSarthi_Test_Accounts.xlsx
JanSarthi_AI_Manual_Test_Script.docx

# Personal interview/recording-prep documents -- reference material for the person working on
# this repo, not app source or documentation meant for the project itself.
JanSarthi_AI_Study_Guide.docx
JanSarthi_AI_Video_Cue_Cards.docx

# Points to the Drive/Sheets links used to hand this project off to the HCLTech team -- external
# sharing reference, not source or documentation meant for the repo itself.
Project_Links.txt

# RAG knowledge base: knowledge_records/ and sources/ are the hand-authored source data;
# everything below is a pure, reproducible function of that source (see
# scripts/build_rag_knowledge_base.py and build_rag_embeddings.py's docstrings), rebuilt at
# Docker image build time -- not committed to avoid a stale/binary blob in git.
data/rag_knowledge_base/chunks/
data/rag_knowledge_base/documents/
data/rag_knowledge_base/embeddings/
data/rag_knowledge_base/schema/
data/rag_knowledge_base/chroma/

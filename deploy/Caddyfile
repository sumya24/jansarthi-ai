# Caddy serves the built React SPA and reverse-proxies the backend's own route prefixes to the
# FastAPI container -- same origin from the browser's point of view, so no CORS hop in
# production (see frontend-react/src/lib/api.ts and its VITE_API_URL fallback).
#
# SITE_ADDRESS defaults to plain HTTP on port 80. Once a domain points at this VM, set
# SITE_ADDRESS=your-domain.com in the .env used by docker-compose.prod.yml and restart -- Caddy
# then automatically provisions and renews a Let's Encrypt TLS certificate for it, no config
# change needed beyond that. See docs/DEPLOYMENT_GCP.md.
{$SITE_ADDRESS:http://:80} {
	encode gzip

	# Several of these prefixes are ALSO real frontend page routes with the identical path
	# (e.g. "/admin", "/admin/workers", "/admin/ai-monitoring" are simultaneously backend API
	# endpoints AND React Router pages -- see vite.config.ts's own dev-proxy version of this same
	# problem, LIVE-REPORTED there first). Without the header check below, a real browser
	# navigation to one of those page URLs (typing it, a bookmark, a hard refresh, a long-idle tab
	# reloading) would ALWAYS match @backend by path alone and get the backend's raw JSON instead
	# of ever reaching the SPA -- worse than the dev version's gap, since here there was no
	# disambiguation at all. `Sec-Fetch-Mode: navigate` is the header browsers set ONLY for a real
	# top-level page load and can't be overridden by JS, so "path matches AND it's not a real page
	# load" is what actually means "proxy this to the backend."
	@backend {
		path /auth* /admin* /complaints* /notifications* /ask-sarthi* /locations* /uploads* /health
		not header Sec-Fetch-Mode navigate
	}
	handle @backend {
		# LIVE-REPORTED BUG: without this, a real top-level navigation to one of the colliding
		# page URLs above (e.g. /admin/ai-monitoring, typed/bookmarked/hard-refreshed) gets this
		# handler's SPA-fallback sibling below serving index.html for that exact GET -- correct,
		# intended behavior on its own. But nothing told the BROWSER not to cache that response,
		# so its own HTTP cache then stored index.html under that URL; moments later, when the
		# now-mounted page's own JS fetches that SAME URL to load its real data, the browser
		# served the cached index.html straight back without even hitting the network, which the
		# frontend's response.json() then failed to parse -- confirmed directly, live. The
		# frontend's own fetch() calls now also pass cache: "no-store" (see api.ts's _fetchJson)
		# as the primary fix; this header is the server-side half of the same fix, so anything
		# that ever calls one of these endpoints without going through that helper is covered too.
		header Cache-Control "no-store"
		reverse_proxy backend:8000
	}

	# Phoenix's own UI (see docs/OBSERVABILITY.md) -- real citizen traffic/costs/questions would
	# otherwise sit behind a public URL with no login of its own at all, since Phoenix has no
	# built-in auth. Gated by asking the BACKEND "is this a real, currently logged-in admin?"
	# (backend/routes/admin.py's phoenix_auth_check()) rather than a separate fixed username/
	# password -- ties access directly to the app's own admin role: give or remove someone's
	# admin role in the app, and their Phoenix access changes with it automatically, no Caddy
	# config change or redeploy needed either way. The browser's own access_token/refresh_token
	# cookies ride along on this forwarded request the same as any other proxied request (plain
	# header forwarding, nothing special configured for it) -- so an admin who's already logged
	# into the app in that browser just gets Phoenix's UI directly, no separate password prompt.
	handle /phoenix-ui* {
		forward_auth backend:8000 {
			uri /admin/phoenix-auth-check
		}
		uri strip_prefix /phoenix-ui
		reverse_proxy phoenix:6006
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}

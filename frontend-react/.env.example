# 127.0.0.1, not localhost -- on Windows, resolving "localhost" tries IPv6 (::1) first; since the
# backend only binds to the IPv4 127.0.0.1, that attempt hangs until it times out (~2s, live-
# measured) before falling back to IPv4 -- a real, consistent ~2s delay on EVERY API call the app
# makes, easily mistaken for a slow page/rendering bug. 127.0.0.1 skips the IPv6 attempt entirely.
VITE_API_URL=http://127.0.0.1:8000

# Error monitoring (see src/main.tsx, docs/ERROR_MONITORING.md). Leave unset (the default) to
# run with no Sentry dependency active at all -- the app behaves identically either way. Get a
# DSN by creating a free project at sentry.io (or your self-hosted instance) and copying its
# "DSN" value from Project Settings > Client Keys.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0

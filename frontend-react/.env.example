# Left unset (the default) -- the frontend dev server (vite.config.ts) now proxies every backend
# route prefix to http://127.0.0.1:8000 itself, so the browser's own fetch calls stay same-origin
# (localhost:5173), exactly like production's Caddy reverse proxy. The 127.0.0.1-not-localhost
# reasoning that used to live here (Windows resolves "localhost" via IPv6 first, ~2s hang before
# falling back to IPv4, since the backend only binds IPv4) still applies -- it's just the proxy's
# own target now, in vite.config.ts, not something the browser ever touches directly. Only set
# this to something (e.g. a different host/port) if you're deliberately bypassing that proxy.
VITE_API_URL=

# Error monitoring (see src/main.tsx, docs/ERROR_MONITORING.md). Leave unset (the default) to
# run with no Sentry dependency active at all -- the app behaves identically either way. Get a
# DSN by creating a free project at sentry.io (or your self-hosted instance) and copying its
# "DSN" value from Project Settings > Client Keys.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0
